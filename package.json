{
  "name": "shoplab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ShopLab - a practice e-commerce store with an admin panel, built for Playwright testing",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite build && node server/index.js",
    "test:e2e": "bddgen && playwright test --project=chromium",
    "test:e2e:all": "bddgen && playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:e2e:mobile": "bddgen && playwright test --project=mobile",
    "test:visual": "bddgen && playwright test --project=visual",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "report": "open reports/cucumber-report.html",
    "report:playwright": "playwright show-report reports/playwright-report"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright-bdd": "^9.2.1",
    "vite": "^8.3.1"
  }
}
